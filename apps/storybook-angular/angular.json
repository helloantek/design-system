{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "newProjectRoot": ".",
  "projects": {
    "storybook": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "styles": [
              "../../node_modules/@fontsource/inter/400.css",
              "../../node_modules/@fontsource/inter/500.css",
              "../../node_modules/@fontsource/geist-mono/400.css",
              "../../packages/tokens/dist/css/scoped/theme-1.css",
              "../../packages/css/src/index.css"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "storybook:build",
            "configDir": ".storybook",
            "tsConfig": "tsconfig.json",
            "port": 6009,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "storybook:build",
            "configDir": ".storybook",
            "tsConfig": "tsconfig.json",
            "outputDir": "storybook-static",
            "compodoc": false,
            "quiet": true
          }
        }
      }
    }
  }
}
