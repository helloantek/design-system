{
  "name": "@helloantek/ds-angular",
  "version": "2.58.0",
  "description": "Angular components for @helloantek/ds. Styles come from @helloantek/ds-css.",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/fesm2022/helloantek-ds-angular.mjs",
  "typings": "./dist/types/helloantek-ds-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/helloantek-ds-angular.d.ts",
      "default": "./dist/fesm2022/helloantek-ds-angular.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@helloantek/ds-css": "^2.0.0"
  },
  "dependencies": {
    "@helloantek/ds-core": "^2.58.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "ng-packagr": "22.2.6",
    "rxjs": "7.8.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
