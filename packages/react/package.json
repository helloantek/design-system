{
  "name": "@helloantek/ds-react",
  "version": "2.13.0",
  "description": "React components for @helloantek/ds. Styles come from @helloantek/ds-css.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0"
  },
  "peerDependencies": {
    "@helloantek/ds-css": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
