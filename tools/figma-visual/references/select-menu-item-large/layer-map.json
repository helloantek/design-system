{
  "$comment": "Figma layer path (as in spec.json) -> element inside the entry's target (one Default Large option; `root` is the target itself) and how to read it.",
  "layers": {
    "root": {},
    "Container": {
      "selector": ".ds-select__content"
    },
    "lead-icon": {
      "selector": ".ds-select__icon"
    },
    "lead-icon/VECTOR": {
      "selector": ".ds-select__icon",
      "fill": "color"
    },
    "label": {
      "selector": ".ds-select__text",
      "skip": [
        "w"
      ]
    },
    "label/TEXT": {
      "selector": ".ds-select__text > .ds-select__label"
    },
    "label/TEXT#1": {
      "selector": ".ds-select__description"
    },
    "Container#1": {
      "selector": ".ds-select__check"
    },
    "Container#1/VECTOR": {
      "selector": ".ds-select__check svg",
      "fill": "color"
    },
    "Badge": {
      "selector": ".ds-badge",
      "stroke": "inset-shadow",
      "skip": [
        "w"
      ],
      "$why": "The badge hugs its text, whose width follows glyph rasterisation."
    },
    "Badge/TEXT": {
      "selector": ".ds-badge__label"
    }
  }
}
