  "$comment": "Figma layer path (as in spec.json) -> element inside the entry's target (the day cell) and how to read it.",
  "layers": {
    "root": {
      "selector": "",
      "skip": [
        "p",
        "g"
      ]
    },
    "DayButton": {
      "selector": ".ds-calendar__day",
      "stroke": "inset-shadow",
